---
import fs from 'node:fs';
import path from 'node:path';
import Nav from '../../../components/jmd/Nav';
import EntrySection from '../../../components/jmd/EntrySection';
import ImageLightbox from '../../../components/jmd/ImageLightbox';

const title = 'Judgement Day 9（ジャッジメント・デイ9） ー ヴァンパイアセイヴァー3on3';
const description = 'Judgement Day 9（ジャッジメント・デイ9） ― 2026年9月20日（日）eスポフィールドにて開催！ヴァンパイアセイヴァー大規模3on3大会。';
const canonicalUrl = 'https://darkstalkers-federation.org/jmd/09/';
const ogImage = 'https://darkstalkers-federation.org/jmd/09/img/ogp.png';

const BLOCKS = ['A','B','C','D','E','F','G','H','I','J','K','L','M','N'];
const BLOCKS2 = ['O','P','Q','R'];
const resultDir = path.join(process.cwd(), 'public/jmd/09/img/result');
const result2Dir = path.join(process.cwd(), 'public/jmd/09/img/result2');

// 1次予選の結果（手書き対戦表の写真。撮影・追加され次第、自動で一覧に反映される）
const firstImages = BLOCKS
  .filter(l => fs.existsSync(path.join(resultDir, `${l}.jpg`)))
  .map(l => ({ src: `/jmd/09/img/result/${l}.jpg`, title: `${l}ブロック` }));

// 2次予選の結果（同上）
const secondImages = BLOCKS2
  .filter(l => fs.existsSync(path.join(result2Dir, `${l}.jpg`)))
  .map(l => ({ src: `/jmd/09/img/result2/${l}.jpg`, title: `${l}ブロック` }));

const groupImages = BLOCKS.map(l => ({ src: `/jmd/09/img/bracket/${l}.png`, title: `${l}ブロック` }));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="keywords" content="Judgement Day,ジャッジメント・デイ,JMD,JMD9,ヴァンパイア,ヴァンパイアセイヴァー,格闘ゲーム大会,格ゲー,3on3,東京,eスポフィールド,2026">
    <link rel="canonical" href={canonicalUrl}>

    <meta property="og:title" content={title}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:description" content={description}>
    <meta property="og:locale" content="ja_JP">
    <meta property="og:site_name" content="Darkstalkers Federation">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@ds_federation">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Judgement Day 9（ジャッジメント・デイ9）",
      "description": "ヴァンパイアセイヴァー大規模3on3大会",
      "startDate": "2026-09-20",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": "eスポフィールド",
        "url": "https://espofield.com/",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "JP",
          "addressLocality": "東京"
        }
      },
      "organizer": {
        "@type": "Organization",
        "name": "Darkstalkers Federation",
        "url": "https://darkstalkers-federation.org"
      },
      "url": canonicalUrl,
      "image": ogImage,
    })} />

    <link rel="shortcut icon" href="/jmd/09/favicon.ico">
    <link rel="icon" type="image/x-icon" href="/jmd/09/favicon.ico">
    <link href="https://fonts.googleapis.com/css?family=IM+Fell+Great+Primer" rel="stylesheet">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="/jmd/08/css/main.css">
    <link rel="stylesheet" href="/jmd/08/css/entry.css">
    <style>
      .container { background-image: url('/jmd/09/img/background.png'); }

#archive ul { display: flex; flex-wrap: wrap; gap: 0 1.5em; padding: 0; }
      #archive ul li { display: inline; padding: 0.2em 1em; text-align: left; }
      #archive ul li a { font-size: 1.1em; color: #ccc; white-space: nowrap; }
      #archive ul li a:hover { color: #fff; text-decoration: underline; }

      #after h4 {
        color: #fff;
        font-weight: bold;
        text-shadow: 0px 0px 10px red, 0px 0px 10px red;
        margin: 1em 0 0.5em;
        padding: 0.5em 0 0;
        border-top: 1px dotted #5E4743;
      }
      .rule-list { list-style: disc; padding-left: 1.4em; margin: 0 0 0.5em; }
      .rule-list li { margin-bottom: 0.4em; }

      .flow-step { margin-bottom: 1em; }
      .flow-step:last-child { margin-bottom: 0; }
      .flow-step h4 {
        font-size: 1em;
        color: #fff;
        font-weight: bold;
        padding: 0.5em 0 0;
        margin: 0 0 0.3em;
        border-top: 1px dotted #5E4743;
        text-shadow: 0px 0px 10px red, 0px 0px 10px red;
      }
      .flow-step:first-child h4 { border-top: none; padding-top: 0; }
      .flow-step small { display: block; padding-left: 1em; }
    </style>
  </head>
  <body>
    <Nav client:only="react" />

    <div class="container">
      <header id="top">
        <div class="title-logo">
          <h1 class="logo">
            <img src="/jmd/09/img/title-logo.png" alt="Judgement Day 9（ジャッジメント・デイ9）">
          </h1>
          <p class="catchphrase">
            <span>審判<span class="hiragana">の</span>日<span class="hiragana">に </span>集結<span class="hiragana">せよ</span> <span class="inline-line"></span> 。</span>
          </p>
          <div class="event-info">
            <div class="event-date">
              <time datetime="2026-09-20">
                <span class="year">2026.</span><span class="month-date">9.20</span><span class="day">Sun</span>
              </time>
            </div>
            <p class="happy20th"><img src="/jmd/08/img/vs_logo.png" alt="Vampire Savior"><span></span></p>
          </div>
        </div>
        <div class="social">
          <ul>
            <li class="twitter">
              <a href="https://twitter.com/share" class="twitter-share-button"
                data-url="https://darkstalkers-federation.org/jmd/09/"
                data-text="Judgement Day 9" data-via="ds_federation"
                data-lang="ja" data-hashtags="JMD9">ツイート</a>
            </li>
          </ul>
        </div>
      </header>

      <div class="contents">

        <!-- 大会概要 -->
        <section id="summary" itemscope itemtype="https://schema.org/Event">
          <meta itemprop="name" content="Judgement Day 9（ジャッジメント・デイ9）">
          <h2 class="event-title">大会概要</h2>
          <p>ヴァンパイアセイヴァー大規模3on3大会<b>Judgement Day 9</b>の開催が決定！</p>
          <p>詳細については順次アップデートします。</p>
          <dl class="event-summary">
            <dt>イベント名称</dt><dd>Judgement Day 9</dd>
            <dt>開催日時</dt><dd>2026年9月20日（日） 10:00〜</dd>
            <dt>ゲームタイトル</dt><dd>ヴァンパイアセイヴァー</dd>
            <dt>大会形式</dt>
            <dd>予選 … 3チームor4チームによるリーグ戦or変則トーナメント（プレーオフあり）</dd>
            <dd>決勝 … 8チームによるシングルイリミネーショントーナメント</dd>
            <dt>参加費</dt>
            <dd>3,000円（観戦のみ1,000円）</dd>
            <dt>会場</dt>
            <dd itemprop="location" itemscope itemtype="https://schema.org/Place">
              <a itemprop="url" href="https://espofield.com/" target="_blank" rel="noopener noreferrer">
                <span itemprop="name">eスポフィールド</span>
              </a>
            </dd>
            <dt>配信</dt>
            <dd><a href="https://www.twitch.tv/gamenewton" target="_blank" rel="noopener noreferrer">Twitch ニュートンチャンネル</a></dd>
          </dl>
        </section>

        <!-- 配信 -->
        <section id="stream">
          <h2>配信</h2>
          <div class="youtube">
            <iframe
              src="https://player.twitch.tv/?channel=gamenewton&parent=darkstalkers-federation.org&parent=darkstalkers.github.io&muted=true"
              frameborder="0"
              allowfullscreen
              title="Judgement Day 9 ライブ配信"
            ></iframe>
          </div>
          <p><a href="https://www.twitch.tv/gamenewton" target="_blank" rel="noopener noreferrer">Twitch ニュートンチャンネルで視聴する</a></p>
        </section>

        <!-- 組み合わせ・トーナメント表（1次予選終了のため非表示） -->
        <!-- <section id="bracket">
          <h2>組み合わせ・トーナメント表</h2>
          <ImageLightbox images={groupImages} client:only="react" />
        </section> -->

        <!-- 対戦表（予選の結果） -->
        {(firstImages.length > 0 || secondImages.length > 0) && (
          <section id="result">
            <h2>リザルト</h2>
            {firstImages.length > 0 && (
              <section class="archive">
                <h3>1次予選</h3>
                <ImageLightbox images={firstImages} client:only="react" />
              </section>
            )}
            {secondImages.length > 0 && (
              <section class="archive">
                <h3>2次予選</h3>
                <ImageLightbox images={secondImages} client:only="react" />
              </section>
            )}
          </section>
        )}

        <!-- タイムテーブル -->
        <section id="timetable">
          <h2>タイムテーブル</h2>
          <dl class="timetable">
            <dt>10:00</dt><dd>開場、事前エントリー確認</dd>
            <dt>11:00</dt>
            <dd>
              1次予選開始
              <small style="display: block; margin-top: 0.3em;">
                1巡目：A・C・D・E<br>
                2巡目：F・G・H・I<br>
                3巡目：B・J・K・L<br>
                4巡目：M・N
              </small>
            </dd>
            <dt>14:40</dt><dd>2次予選開始</dd>
            <dt>15:50</dt><dd>プレーオフB開始</dd>
            <dt>16:30</dt><dd>プレーオフA開始</dd>
            <dt>17:40</dt><dd>決勝トーナメント開始</dd>
            <dt>19:10</dt><dd>表彰式</dd>
          </dl>
          <small>※ スケジュールは当日の進行状況により、変更となる場合があります。</small>
        </section>

        <!-- エントリーリスト（React・フル機能） -->
        <EntrySection
          client:only="react"
          dbPath="09/data"
          iconBase="/jmd/08/img/icons/"
          readOnly={false}
        />

        <section id="regulation">
          <h2>大会ルール</h2>
          <section>
            <h3>レギュレーション</h3>
            <div class="section-inner">
              <ul class="rule-list">
                <li>3on3チームマッチ</li>
                <li>スピード：ターボ3固定</li>
                <li>使用キャラの変更不可</li>
                <li>その他は工場出荷デフォルト設定</li>
                <li>特定技によるガード不能バグについては、広く認知されているので制限無し。ただしゲーム続行不能になるバグの利用は禁止（アナカリスの無敵状態は可）</li>
                <li>試合開始前にジャンケンを行い、勝利した側がコンパネ選択権（1Por2P）を得る</li>
                <li>試合開始前に先鋒の選手を審判に申告する。その後の変更は認めない</li>
                <li><b class="underline">勝ち抜き戦とし、中堅以降の順序は自由に決定できる</b></li>
                <li>コンパネの不具合が発生した場合はプレイを中断し、即座に運営へ申告すること</li>
                <li>ダブルKOは再試合</li>
              </ul>
            </div>
          </section>
          <section>
            <h3>大会進行の流れ</h3>
            <div class="section-inner">
              <div class="flow-step">
                <h4>1次予選</h4>
                <ul class="rule-list">
                  <li>1ブロック3枠のリーグ戦or4枠の変則トーナメントを行います。</li>
                  <li>組み合わせは事前に運営がくじ引きを行い決定した通りです。</li>
                  <li>1位14チームが2次予選へ進みます。</li>
                  <li>2位14チームはプレーオフBへ進みます。</li>
                </ul>
              </div>
              <div class="flow-step">
                <h4>2次予選</h4>
                <ul class="rule-list">
                  <li>決勝トーナメントへ進出できる枠数は4枠。</li>
                  <li>1次予選1位抜け14チームを4ブロックに振り分け、3チームのリーグ戦2ブロックと4チームのシングルエリミネーショントーナメントを2ブロックを行います。</li>
                  <li>各ブロック1位のチームが決勝トーナメントへ進みます。</li>
                  <li>それ以外のチームはプレーオフAへ進みます。</li>
                </ul>
                <small>※組み合わせは運営がくじ引きを行います。</small>
              </div>
              <div class="flow-step">
                <h4>プレーオフB</h4>
                <ul class="rule-list">
                  <li>プレーオフAに進出できる枠数は2枠。</li>
                  <li>1次予選2位抜け14チームを7チームずつに分け、代表者によるシングルエリミネーショントーナメントを行い、トーナメントを勝ち抜けた2チームがプレーオフAへ進出します。</li>
                </ul>
                <small>
                  ※組み合わせは運営がくじ引きを行います。<br>
                  ※1回戦は1チームシードとなります。<br>
                  ※直前に選出された代表者は出場不可とします。（初戦プレイヤーが3回戦に出るのは可）
                </small>
              </div>
              <div class="flow-step">
                <h4>プレーオフA</h4>
                <ul class="rule-list">
                  <li>決勝トーナメントへ進出できる枠数は4枠。</li>
                  <li>2次予選で決勝トーナメントに進出しなかった10チーム＋プレーオフB勝ち抜け2チームの計12チームを4ブロックに振り分け、1ブロック3枠のリーグ戦を行います。</li>
                  <li>各ブロック1位の4チームが決勝トーナメントへ進出します。</li>
                </ul>
                <small>※組み合わせは運営がくじ引きを行います。</small>
              </div>
              <div class="flow-step">
                <h4>決勝トーナメント</h4>
                <ul class="rule-list">
                  <li>2次予選勝ち抜けの4チーム＋プレーオフAの勝ち抜け4チームの8枠による、シングルイリミネーショントーナメントで勝ち抜いた1チームが優勝となります。</li>
                  <li>また、準決勝で敗退した2チームによる3位決定戦を決勝戦の前に行います。</li>
                  <li>組み合わせはくじ引きを行い、くじの番号順にトーナメントの位置を選択します。</li>
                  <li>相手チームが決まっている枠を選択した場合、選択された側は1回限り拒否権を行使できます。拒否権を使用されたチームは位置選択順の最後に回ります。</li>
                </ul>
              </div>
              <div class="flow-step">
                <h4>リーグ戦の注意事項</h4>
                <ul class="rule-list">
                  <li>各3チームリーグは勝ち星が三つ巴となった場合は代表者戦で再試合を行います。</li>
                  <li>再度三つ巴になった場合は1巡目の代表者戦に出場したプレイヤーは選出不可とします。</li>
                  <li>2巡目も三つ巴になり決着がつかない場合は3巡目を行い、1巡目・2巡目のプレイヤーは選出不可とします。</li>
                </ul>
              </div>
            </div>
          </section>
          <section>
            <h3>注意事項</h3>
            <div class="section-inner">
              <ul class="rule-list">
                <li>当日はライブ配信およびメディア取材等で会場内の映像配信や写真撮影が行われます。
また、参加者は肖像、氏名、プレイヤー名、チーム名、プレイ動画、インタビューコメント等が、当団体若しくは第三者によってウェブサイトその他情報メディア等において編集し公開、報道利用される可能性があります。予めご了承下さい。</li>
                <li>会場内は終日禁煙となります。店舗入り口の喫煙ルームをご使用下さい。混雑時は一階パチンコ店の大型喫煙ルームをお使い下さい（※特別に許可いただいています）。</li>
                <li>会場内への飲食物の持ち込みは厳禁です。</li>
                <li><b class="underline">当日は会場全エリア貸切となりますので、通常利用時必要となる会員登録は必要ありません</b>。</li>
                <li>児童の入場料はかかりません。</li>
                <li>未成年者も入場、打ち上げの参加は可能ですが、飲酒は固くお断りいたします。</li>
                <li>他の参加者・店舗への迷惑行為を行うプレイヤーの参加は禁止です。</li>
                <li>運営側判断でエントリーを取り消しさせていただく場合があります。</li>
              </ul>
            </div>
          </section>
        </section>

        <!-- その他 -->
        <section id="others">
          <h2>その他</h2>
          <section id="party">
            <h3>打ち上げについて</h3>
            <p class="after-party">
              大会終了後にイベント会場を飲み会モードに転換し、その場で打ち上げを行います。
              選手としてエントリーされる方は、エントリーフォームからそのままお申込みいただけます。
              <!--<b class="underline">観戦のみで、打ち上げにご参加希望の方</b>向けの受付は締め切りました。-->
            </p>
            <small style="text-decoration: underline;">※ 募集は締め切りました。ありがとうございました！</small>
            <dl class="party-summary">
              <dt>場所</dt><dd><a href="https://espofield.com/" target="_blank" rel="noopener noreferrer">eスポフィールド</a></dd>
              <dt>時間</dt><dd>大会終了後から2時間</dd>
              <dt>会費</dt><dd>4,000円（ビュッフェ形式+飲み放題）</dd>
            </dl>
          </section>
          <section id="volunteers">
            <h3>運営ボランティア募集！</h3>
            <p>運営進行を手伝っていただける方を募集しています。具体的な作業内容は以下のようなものを想定しています。</p>
            <ul class="rule-list">
              <li>実況・解説（MC）：3～4人<br>状況に応じて交代で行います。</li>
              <li>試合管理・書記：4～5人<br>こちらも自分の予選ブロック以外を担当してもらいます。主な業務は、双方の先鋒を確認、試合経過を専用シートに記入、結果を運営本部に報告、その他雑用など。</li>
            </ul>
            <small style="text-decoration: underline;">※ 募集は締め切りました。ありがとうございました！</small>
          </section>
          <section id="lending">
            <h3>アーケードコントローラー貸与のお願い</h3>
            <p>
              会場の野試合用に設置されるSteam版ファイティングコレクションにて使用するアーケードコントローラーを貸与して下さる方を募集します。
              もしお貸し頂けるのであれば、詳細を下記フォームにてご確認頂き、ご登録をお願い致します。
            </p>
            <small style="text-decoration: underline;">※ おかげさまで必要数が揃いました。ご協力ありがとうございました！</small>
          </section>
          <section id="after">
            <h3>後夜祭</h3>
            <ul>
              <li>2026年9月21日（月）</li>
              <li>12:00開店　13:00試合開始</li>
              <li>開催場所：ゲームニュートン大山店</li>
              <li>形式：2on2形式トーナメント（事実上シングル戦）</li>
              <li>参加費：200円</li>
            </ul>
            <h4>後夜祭ルール</h4>
            <ul class="rule-list">
              <li>2on2の形をとった事実上のシングル戦です。形式上のタッグを決め、先鋒・大将でそれぞれ1試合ずつ計2試合を行い、タッグに関わらずその2試合で負けた2名が敗退となります。決定戦はありません。</li>
              <li>参加者全員が順番決めの抽選を行い、その後に順番通りに名札（本人とは限りません）をくじ引きします。その名札を好きな場所に配置することによってトーナメントを形成します。</li>
              <li>引いた参加者の名前が書かれた名札を、トーナメントの組み合わせの空いている中の好きな場所へ、配置していきます。人数が半端な場合のシード、指定された場所への拒否権はありません。</li>
              <li>トーナメント確定後、じゃんけんで1P/2Pを決めてから、組み合わされた2人で先鋒・大将を相手に分からないように決めて着席し、対戦します。</li>
              <li>以上の順番決めから対戦までを繰り返し、最後に残る優勝者を決めます。（景品あり）</li>
            </ul>
