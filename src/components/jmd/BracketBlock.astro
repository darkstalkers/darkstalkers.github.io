---
import type { BracketBlockData } from '../../lib/jmd/bracket';
import BracketTeamCard from './BracketTeamCard.astro';

interface Props {
  block: BracketBlockData;
}
const { block } = Astro.props;
---

<div class="bracket-block">
  <h4 class="bracket-block-label">{block.label} ブロック</h4>

  {block.type === 'tree' ? (
    <>
      <div class="bracket-pair">
        <BracketTeamCard team={block.teams[0]} isWinner={block.semiWinner1 === 0} />
        <BracketTeamCard team={block.teams[1]} isWinner={block.semiWinner1 === 1} />
      </div>
      <div class="bracket-pair">
        <BracketTeamCard team={block.teams[2]} isWinner={block.semiWinner2 === 0} />
        <BracketTeamCard team={block.teams[3]} isWinner={block.semiWinner2 === 1} />
      </div>
      {block.finalWinner && (
        <p class="bracket-champion">
          🏆 ブロック優勝：
          {block.finalWinner === 'semi1'
            ? block.teams[block.semiWinner1 as number].name
            : block.teams[2 + (block.semiWinner2 as number)].name}
        </p>
      )}
    </>
  ) : (
    <div class="bracket-roundrobin">
      <p class="bracket-format-note">※ 3チーム総当たり戦</p>
      {block.teams.map((t, i) => (
        <BracketTeamCard team={t} isWinner={block.winner === i} />
      ))}
    </div>
  )}
</div>

<style>
  .bracket-block {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid #5e4743;
    padding: 1em;
  }
  .bracket-block-label {
    margin: 0 0 0.75em;
    text-align: center;
    color: #fff;
    text-shadow: 0 0 8px red, 0 0 8px red;
  }
  .bracket-pair {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    margin-bottom: 0.75em;
    padding-bottom: 0.75em;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.2);
  }
  .bracket-pair:last-of-type {
    border-bottom: none;
  }
  .bracket-roundrobin {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
  .bracket-format-note {
    margin: 0 0 0.25em;
    font-size: 0.85em;
    color: #ccc;
  }
  .bracket-champion {
    margin: 0.75em 0 0;
    padding-top: 0.5em;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-weight: bold;
    color: #ff5050;
    text-align: center;
  }
</style>
